var totalWords = Math.max(words1.length, words2.length); return matches / totalWords; }

function findFullAnalysisMatch(bulkRow, fullAnalysisData, threshold) { threshold = threshold || 0.75; // 75% podobieństwa

var bulkCampaign = normalizeForMatching(bulkRow.campaign); var bulkAdGroup = normalizeForMatching(bulkRow.adGroup); var bulkTarget = normalizeForMatching(bulkRow.targeting || bulkRow.keywordText);

var bestMatch = null; var bestScore = 0;

for (var i = 0; i < fullAnalysisData.length; i++) { var faRow = fullAnalysisData[i];

var campaignScore = fuzzyMatchScore(bulkCampaign, faRow.campaign);
var adGroupScore = fuzzyMatchScore(bulkAdGroup, faRow.adGroup);
var targetScore = fuzzyMatchScore(bulkTarget, faRow.targeting || faRow.keywordText);

// Średnia ważona (target najważniejszy)
var totalScore = (campaignScore * 0.3) + (adGroupScore * 0.3) + (targetScore * 0.4);

if (totalScore > bestScore && totalScore >= threshold) {
  bestScore = totalScore;
  bestMatch = faRow;
}

}

