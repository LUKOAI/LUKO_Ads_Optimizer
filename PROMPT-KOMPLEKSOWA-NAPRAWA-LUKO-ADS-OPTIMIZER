return String(text) .toLowerCase() .replace(/[^a-z0-9\s]/g, '') // usuń znaki specjalne .replace(/\s+/g, ' ') // normalizuj spacje .trim(); }

function fuzzyMatchScore(str1, str2) { var norm1 = normalizeForMatching(str1); var norm2 = normalizeForMatching(str2);

// Dokładne dopasowanie if (norm1 === norm2) return 1.0;

// Jeden zawiera drugi if (norm1.includes(norm2) || norm2.includes(norm1)) { var longer = Math.max(norm1.length, norm2.length); var shorter = Math.min(norm1.length, norm2.length); return shorter / longer; }

// Wspólne słowa var words1 = norm1.split(/\s+/); var words2 = norm2.split(/\s+/);

